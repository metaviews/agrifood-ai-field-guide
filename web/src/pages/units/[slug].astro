---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { KIND_LABELS, GOV_LABELS, verifChip } from '../../unit-facets.ts';
import { parseEvidenceLinks } from '../../evidence-chain.ts';
import EvidenceFooter from '../../components/EvidenceFooter.astro';

export async function getStaticPaths() {
  const units = await getCollection('units');
  return units.map((unit) => ({
    params: { slug: unit.id },
    props: { unit },
  }));
}
const { unit } = Astro.props;
const { Content } = await render(unit);
const title = unit.data.title ?? unit.id;

const kind = unit.data['unit-kind'];
const gov = unit.data['governance-level'];
const vChip = verifChip(unit.data['maturity-verification']);

// Evidence-chain footer for integrative (meta-pattern) syntheses: surface the
// units/gaps/contested-claims that remarkStripMeta removes from the prose.
const evidence = parseEvidenceLinks(unit.body);
const showEvidence = kind === 'meta-pattern'
  && (evidence.units.length > 0 || evidence.gapsText || evidence.claimsText);
const allUnits = await getCollection('units');
const unitTitles = Object.fromEntries(allUnits.map((u) => [u.id, u.data.title ?? u.id]));
---

<Base title={title} description={unit.data.summary ?? `Unit: ${title}`}>
  <nav class="back-link">
    <a href="/units/">&larr; All units</a>
  </nav>
  <h1>{title}</h1>
  {unit.data.region && (
    <p class="unit-region">{unit.data.region}</p>
  )}
  {(kind || gov || vChip) && (
    <p class="unit-taxonomy" title="Taxonomy v6 tags from this unit's frontmatter">
      {kind && <span class="chip">{KIND_LABELS[kind] ?? kind}</span>}
      {gov && <span class="chip">{GOV_LABELS[gov] ?? gov}</span>}
      {vChip && <span class="chip" title="Verification tier (maturity-verification)">{vChip}</span>}
    </p>
  )}
  <Content />
  {showEvidence && <EvidenceFooter links={evidence} unitTitles={unitTitles} />}
</Base>

<style>
  .back-link {
    font-size: 0.9rem;
    color: var(--ink-soft);
    margin-bottom: 1rem;
  }
  .unit-region {
    font-style: italic;
    color: var(--ink-soft);
    margin-top: -0.5em;
    margin-bottom: 1.5em;
    font-size: 0.95rem;
  }
  .unit-taxonomy {
    margin-top: -1em;
    margin-bottom: 1.5em;
  }
  .chip {
    display: inline-block;
    font-size: 0.75rem;
    line-height: 1.7;
    border: 1px solid var(--rule);
    border-radius: 2px;
    padding: 0 0.5em;
    margin-right: 0.4em;
    color: var(--ink-faint);
    white-space: nowrap;
  }
</style>
