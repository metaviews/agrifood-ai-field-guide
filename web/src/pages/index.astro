---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const units = await getCollection('units');
const quotes = await getCollection('quotes');
const allTalks = await getCollection('talks');
const archetypes = allTalks.filter((t) => t.data.archetype_number !== undefined);
const consolidations = await getCollection('synthesis');
const patterns = units.filter((u) => u.data['unit-kind'] === 'meta-pattern');
const synthesisCount = consolidations.length + patterns.length;

// Featured syntheses for the findings-first front door: a topic synthesis,
// a cross-cycle consolidation, and a cross-repo bridge.
const byId = new Map(units.map((u) => [u.id, u]));
const conById = new Map(consolidations.map((c) => [c.id, c]));
const featured = [
  byId.get('row-crop-ai-deployment-synthesis'),
  conById.get('eu-china-cycles-2026-09'),
  byId.get('farm-succession-and-ai-transfer-moment'),
].filter(Boolean).map((item) => {
  const isUnit = byId.has(item.id);
  return {
    title: item.data.title ?? item.id,
    summary: item.data.summary,
    href: isUnit ? `/units/${item.id}/` : `/synthesis/${item.id}/`,
  };
});
---

<Base title="Agrifood AI Field Guide" cover={true} description="A working knowledge base on artificial intelligence in agrifood systems — integrated syntheses, concrete deployments, regional scans, talk methodology, and speaker voices.">
  <h1>Agrifood AI Field Guide</h1>

  <p>
    A working knowledge base on artificial intelligence in agrifood systems.
    Each unit documents a concrete AI deployment with named-source evidence;
    syntheses integrate units into cross-case and cross-region readings;
    quotes carry the voices of named speakers. Start with the synthesis layer
    for the integrated understanding, then follow the links down to the units
    for the evidence.
  </p>

  <h2>What the corpus currently understands</h2>
  <p class="featured-intro">
    A few headline syntheses — each led by its central claim. The full set is
    in the <a href="/synthesis/">Synthesis</a> layer.
  </p>
  <div class="featured">
    {featured.map((f) => (
      <a href={f.href} class="featured-card">
        <span class="featured-title">{f.title}</span>
        {f.summary && <span class="featured-claim">{f.summary}</span>}
      </a>
    ))}
  </div>

  <h2>Browse the corpus</h2>

  <div class="counts">
    <a href="/synthesis/" class="count-card">
      <span class="count-num">{synthesisCount}</span>
      <span class="count-label">syntheses</span>
      <span class="count-desc">Integrated readings across cases and regions — start here.</span>
    </a>
    <a href="/units/" class="count-card">
      <span class="count-num">{units.length}</span>
      <span class="count-label">units</span>
      <span class="count-desc">Concrete deployments of AI in agrifood, with sources.</span>
    </a>
    <a href="/quotes/" class="count-card">
      <span class="count-num">{quotes.length}</span>
      <span class="count-label">quotes</span>
      <span class="count-desc">Named speakers, verbatim and paraphrased.</span>
    </a>
    <a href="/talks/" class="count-card">
      <span class="count-num">{archetypes.length}</span>
      <span class="count-label">talk archetypes</span>
      <span class="count-desc">Repeatable talk-assembly patterns with named units and quotes, plus methodology docs.</span>
    </a>
  </div>

  <p class="about-link">
    The source repository is on
    <a href="https://github.com/metaviews/agrifood-ai-field-guide">GitHub</a>
    &mdash; including the
    <a href="https://github.com/metaviews/agrifood-ai-field-guide/blob/main/taxonomy/v5.md">taxonomy</a>,
    <a href="https://github.com/metaviews/agrifood-ai-field-guide/blob/main/VISION.md">project vision</a>,
    and contribution discipline.
  </p>

  <h2>About this resource</h2>
  <p>
    This knowledge base was assembled with the help of
    <a href="https://hermes-agent.nousresearch.com/docs">Hermes Agent</a>
    and <a href="https://nousresearch.com">MiniMax M3</a>. The corpus is
    maintained as a public open-source project; every unit, scan, quote,
    and archetype is released under
    <a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a>.
    Contributions, corrections, and additions are welcome via
    <a href="https://github.com/metaviews/agrifood-ai-field-guide/issues">GitHub issues</a>
    or pull requests.
  </p>
</Base>

<style>
  .featured-intro { font-size: 0.95rem; color: var(--ink-soft); margin-top: -0.3rem; }
  .featured-intro a { color: var(--ink); }
  .featured {
    display: grid; grid-template-columns: 1fr; gap: 0.85rem; margin: 1rem 0 2.5rem 0;
  }
  .featured-card {
    display: flex; flex-direction: column; gap: 0.45em;
    padding: 1rem 1.15rem; background: var(--cream-soft);
    border: 1px solid var(--rule); border-left: 3px solid var(--ink-soft);
    border-radius: 3px; text-decoration: none; color: var(--ink);
    transition: border-color 0.15s, background 0.15s;
  }
  .featured-card:hover { border-color: var(--ink-soft); background: var(--cream-dark); }
  .featured-title { font-weight: 600; font-size: 1.02rem; line-height: 1.3; }
  .featured-claim { font-size: 0.9rem; color: var(--ink-soft); line-height: 1.5; }
  .counts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 0.85rem;
    margin: 1.5rem 0 2rem 0;
  }
  .count-card {
    display: flex;
    flex-direction: column;
    gap: 0.2em;
    padding: 0.95rem 1rem;
    background: var(--cream-soft);
    border: 1px solid var(--rule);
    border-radius: 3px;
    text-decoration: none;
    color: var(--ink);
    transition: border-color 0.15s, background 0.15s;
  }
  .count-card:hover {
    border-color: var(--ink-soft);
    background: var(--cream-dark);
  }
  .count-num {
    font-size: 1.85rem;
    font-weight: 600;
    color: var(--ink);
    line-height: 1;
  }
  .count-label {
    font-size: 1rem;
    color: var(--ink-soft);
    font-style: italic;
  }
  .count-desc {
    font-size: 0.85rem;
    color: var(--ink-faint);
    margin-top: 0.3em;
  }
  .about-link {
    margin-top: 2rem;
    font-size: 0.95rem;
    color: var(--ink-soft);
  }
  @media (min-width: 720px) { .featured { grid-template-columns: 1fr 1fr 1fr; } }
</style>